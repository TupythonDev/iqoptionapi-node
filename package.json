{
  "name": "iqoptionapi-node",
  "version": "1.0.0",
  "description": "TypeScript SDK for the IQOption WebSocket API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TupythonDev/iqoptionapi-node.git"
  },
  "homepage": "https://github.com/TupythonDev/iqoptionapi-node#readme",
  "bugs": {
    "url": "https://github.com/TupythonDev/iqoptionapi-node/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPattern=tests/unit --passWithNoTests",
    "test:integration": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --testPathPattern=tests/unit --passWithNoTests",
    "lint": "eslint src tests examples",
    "lint:fix": "eslint src tests examples --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "keywords": [
    "iqoption",
    "trading",
    "websocket",
    "typescript",
    "binary-options"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.27.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.14",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
